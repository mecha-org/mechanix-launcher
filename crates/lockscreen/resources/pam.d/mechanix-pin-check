#%PAM-1.0
# The PIN itself, with faillock as in system-auth. Its own stack, so lines
# added to mechanix-pin never land inside the jump below.
# Install to /etc/pam.d/mechanix-pin-check.
auth     required                 pam_faillock.so  preauth
auth     [success=1 default=bad]  pam_pwdfile.so   pwdfile=/etc/mechanix/pin.passwd
auth     [default=die]            pam_faillock.so  authfail
auth     required                 pam_faillock.so  authsucc
